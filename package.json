{
  "name": "dsh-plugin-turn-memory",
  "version": "0.2.0-dev",
  "description": "Turn and session transcript memory rewriting for DeepSeek Harness.",
  "license": "MIT",
  "author": "vilicvane",
  "type": "module",
  "files": [
    "index.ts",
    "lib/*.ts",
    "e2e/*.ts",
    "prompts/*.md"
  ],
  "exports": {
    ".": "./index.ts",
    "./e2e-runner": "./e2e/runner.ts",
    "./prompt-eval-runner": "./e2e/prompt-eval-runner.ts",
    "./prompt-matrix-runner": "./e2e/prompt-matrix-runner.ts",
    "./session-compaction-e2e-runner": "./e2e/session-compaction-runner.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.7",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.7",
    "@deepseek-ai/dsh-token-meter": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "pnpm test && pnpm typecheck",
    "e2e": "bash scripts/e2e-smoke.sh",
    "e2e:prompt": "bash scripts/e2e-prompt.sh",
    "e2e:prompt:repeat": "node scripts/repeat-prompt-eval.mjs",
    "e2e:prompt:matrix": "bash scripts/e2e-prompt-matrix.sh",
    "e2e:session": "bash scripts/e2e-session-compaction.sh"
  }
}
